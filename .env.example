# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/osticket_mern

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE=7d

# Email (Nodemailer SMTP). Leave EMAIL_HOST empty to log emails to console + email_logs collection.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="osTicket Support <support@osticket.local>"

# Inbound email-to-ticket (IMAP polling). One shared poller routes per-message
# to the hired organisation via To/Cc -> Company.supportEmail/email/domain.
# Set each tenant's inbox in Settings > Company Profile (supportEmail).
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_POLL_INTERVAL=60000
EMAIL_INBOUND_WINDOW_DAYS=1
# Optional: force ALL inbound mail to one tenant (disables per-org routing).
EMAIL_DEFAULT_COMPANY=
# Legacy global fallback shown when a tenant has no supportEmail set.
EMAIL_TO_TICKET_ADDRESS=

# Client URLs (used in email links)
CLIENT_URL=http://localhost:5173
AGENT_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Uploads
MAX_FILE_SIZE=5242880

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=300
