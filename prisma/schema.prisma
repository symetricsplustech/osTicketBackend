}

model CatalogItem {
  id                String    @id @default(cuid())
  tenantId          String
  categoryId        String?
  name              String
  slug              String
  shortDescription  String?
  description       String?
  itemType          String    @default("SERVICE")
  status            String    @default("DRAFT")
