// ---------------------------------------------------------------------------
// ITSM SaaS Platform — canonical database schema (PostgreSQL)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum UserType {
  PLATFORM_STAFF
  TENANT_USER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MfaFactorType {
  TOTP
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
  FAILED
}

enum DomainType {
  CUSTOM
  SUBDOMAIN
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  DISABLED
  FAILED
}

enum CertificateStatus {
  NONE
  PENDING
  ISSUED
  EXPIRED
  FAILED
}

enum ProvisioningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AccessPolicySubjectType {
  USER
  ROLE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

enum CatalogStatus {
  DRAFT
  ENABLED
  DISABLED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderStatus {
  UNVERIFIED
  ACTIVE
  DISABLED
  ERROR
}

enum IntegrationStatus {
  UNCONFIGURED
  ENABLED
  DISABLED
  ERROR
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
  SUPPRESSED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  REOPENED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReportJobKind {
  REPORT
  EXPORT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum LoginOutcome {
  SUCCESS
  FAILURE
  MFA_REQUIRED
  MFA_FAILED
  LOCKED
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RetentionAction {
  DELETE
  ARCHIVE
}

// ===========================================================================
// Customer management (Tenant / Organization Admin)
// ===========================================================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerContactRole {
  PRIMARY
  TECHNICAL
  BILLING
  AUTHORIZED
}

enum CustomerPortalStatus {
  NONE
  INVITED
  ACTIVE
  REVOKED
}

// ===========================================================================
// Tenant administration (Organization Admin)
// ===========================================================================

enum PermissionScope {
  PLATFORM
  TENANT
}

enum TenantRoleStatus {
  ACTIVE
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ===========================================================================
// Identity
// ===========================================================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String?
  firstName           String
  lastName            String
  displayName         String?
  phone               String?
  avatarUrl           String?
  jobTitle            String?
  timezone            String     @default("UTC")
  locale              String     @default("en-US")
  userType            UserType   @default(PLATFORM_STAFF)
  status              UserStatus @default(INVITED)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  mfaEnabled          Boolean    @default(false)
  invitationTokenHash String?
  invitationExpiresAt DateTime?
  metadata            Json?
  createdById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  sessions                       Session[]
  mfaFactors                     MfaFactor[]
  recoveryCodes                  MfaRecoveryCode[]
  passwordResetTokens            PasswordResetToken[]
  staffRoleAssignments           StaffRoleAssignment[]    @relation("StaffRoleUser")
  rolesAssigned                  StaffRoleAssignment[]    @relation("StaffRoleAssigner")
  memberships                    TenantMembership[]
  managedDepartments             Department[]             @relation("DepartmentManager")
  ledTeams                       Team[]                   @relation("TeamLead")
  teamMemberships                TeamMember[]
  accessPolicyAssignments        AccessPolicyAssignment[]
  approvalRequests               ApprovalRequest[]        @relation("ApprovalRequester")
  approvalDecisions              ApprovalDecision[]
  auditEvents                    AuditEvent[]
  loginEvents                    LoginEvent[]
  securityEvents                 SecurityEvent[]
  slaClockEvents                 SlaClockEvent[]
  supportTicketsCreated          SupportTicket[]          @relation("SupportTicketCreator")
  supportTicketsAssigned         SupportTicket[]          @relation("SupportTicketAssignee")
  supportReplies                 SupportReply[]
  supportAssignments             SupportAssignment[]      @relation("SupportAssignmentTarget")
  supportAssignmentsMade         SupportAssignment[]      @relation("SupportAssignmentActor")
  apiKeys                        ApiKey[]
  integrationsCreated            Integration[]            @relation("IntegrationCreator")
  webhooksCreated                Webhook[]                @relation("WebhookCreator")
  emailProviders                 EmailProvider[]
  reportJobs                     ReportJob[]
  backgroundJobs                 BackgroundJob[]
  impersonationRequests          ImpersonationSession[]   @relation("ImpersonationRequester")
  incidentsCalled                Incident[]               @relation("IncidentCaller")
  incidentsAssigned              Incident[]               @relation("IncidentAssignee")
  incidentCommentsAuthored       IncidentComment[]        @relation("IncidentCommentAuthor")
  problemsAssigned               Problem[]                @relation("ProblemAssignee")
  problemCommentsAuthored        ProblemComment[]         @relation("ProblemCommentAuthor")
  changesAssigned                Change[]                 @relation("ChangeAssignee")
  changesRequested               Change[]                 @relation("ChangeRequester")
  changeCommentsAuthored         ChangeComment[]          @relation("ChangeCommentAuthor")
  serviceRequestsAssigned        ServiceRequest[]         @relation("ServiceRequestAssignee")
  serviceRequestsRequestedFor    ServiceRequest[]         @relation("ServiceRequestRequestedFor")
  serviceRequestCommentsAuthored ServiceRequestComment[]  @relation("ServiceRequestCommentAuthor")
  catalogItemVersionsPublished   CatalogItemVersion[]     @relation("CatalogItemVersionPublisher")

  @@index([userType, status])
  @@index([email])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  activeTenantId   String?
  mfaVerifiedAt    DateTime?
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model MfaFactor {
  id         String        @id @default(cuid())
  userId     String
  type       MfaFactorType @default(TOTP)
  label      String?
  secretEnc  String
  verifiedAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, verifiedAt])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ===========================================================================
// Platform access control
// ===========================================================================

model Permission {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  module      String
  description String?
  scope       PermissionScope @default(PLATFORM)
  resource    String?
  action      String?
  isSystem    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  rolePermissions       RolePermission[]
  tenantRolePermissions TenantRolePermission[]

  @@index([module])
  @@index([scope, module])
  @@map("permissions")
}

model PlatformRole {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions      RolePermission[]
  staffAssignments StaffRoleAssignment[]

  @@map("platform_roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model StaffRoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  user       User         @relation("StaffRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?        @relation("StaffRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@map("staff_role_assignments")
}

model AccessPolicy {
  id          String    @id @default(cuid())
  name        String
  description String?
  policyType  String
  rules       Json
  priority    Int       @default(100)
  isEnabled   Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  assignments AccessPolicyAssignment[]

  @@index([policyType, isEnabled])
  @@map("access_policies")
}

model AccessPolicyAssignment {
  id          String                  @id @default(cuid())
  policyId    String
  subjectType AccessPolicySubjectType
  subjectId   String
  createdAt   DateTime                @default(now())

  policy AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([policyId, subjectType, subjectId])
  @@map("access_policy_assignments")
}

// ===========================================================================
// Tenants
// ===========================================================================

model Tenant {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  status              TenantStatus       @default(PROVISIONING)
  primaryContactName  String?
  primaryContactEmail String?
  timezone            String             @default("UTC")
  locale              String             @default("en-US")
  industry            String?
  website             String?
  notes               String?
  provisioningStatus  ProvisioningStatus @default(NOT_STARTED)
  provisionAttempts   Int                @default(0)
  provisionError      String?
  provisionedAt       DateTime?
  activatedAt         DateTime?
  suspendedAt         DateTime?
  suspendedReason     String?
  archivedAt          DateTime?
  archivedReason      String?
  metadata            Json?
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  domains                    TenantDomain[]
  settings                   TenantSetting[]
  memberships                TenantMembership[]
  roles                      TenantRole[]
  userRoles                  TenantUserRole[]
  invitations                Invitation[]
  departments                Department[]
  locations                  Location[]
  costCenters                CostCenter[]
  teams                      Team[]
  teamMembers                TeamMember[]
  provisionings              TenantProvisioning[]
  serviceAssignments         TenantServiceAssignment[]
  slaAssignments             TenantSlaAssignment[]
  workflowAssignments        TenantWorkflowAssignment[]
  itsmConfigurations         TenantItsmConfiguration[]
  knowledgeSetting           KnowledgeTenantSetting?
  cmdbConfiguration          TenantCmdbConfiguration?
  impersonationSessions      ImpersonationSession[]
  auditEvents                AuditEvent[]
  securityEvents             SecurityEvent[]
  supportTickets             SupportTicket[]
  apiKeys                    ApiKey[]
  reportJobs                 ReportJob[]
  incidents                  Incident[]
  incidentComments           IncidentComment[]
  problems                   Problem[]
  problemComments            ProblemComment[]
  changes                    Change[]
  changeComments             ChangeComment[]
  serviceRequests            ServiceRequest[]
  serviceRequestComments     ServiceRequestComment[]
  catalogCategories          CatalogCategory[]
  catalogItems               CatalogItem[]
  catalogItemVersions        CatalogItemVersion[]
  knowledgeArticles          KnowledgeArticle[]
  knowledgeArticleCategories KnowledgeArticleCategory[]
  knowledgeArticleComments   KnowledgeArticleComment[]
  configurationItems         ConfigurationItem[]
  ciRelationships            CiRelationship[]
  assets                     Asset[]
  assetMaintenances          AssetMaintenance[]
  discoveryRuns              DiscoveryRun[]
  discoveryResults           DiscoveryResult[]
  onCallSchedules            OnCallSchedule[]
  onCallShifts               OnCallShift[]
  releases                   Release[]
  knownErrors                KnownError[]
  majorIncidents             MajorIncident[]
  vendors                    Vendor[]
  announcements              Announcement[]
  customers                  Customer[]
  customerContacts           CustomerContact[]
  customerSites              CustomerSite[]
  approvalPolicies           TenantApprovalPolicy[]
  approvalRequests           TenantApprovalRequest[]
  approvalDecisions          TenantApprovalDecision[]
  slaPolicies                TenantSlaPolicy[]
  slaEscalationRules         TenantSlaEscalationRule[]
  businessCalendars          TenantBusinessCalendar[]
  slaInstances               TicketSlaInstance[]
  slaClockEvents             SlaClockEvent[]
  workflows                  TenantWorkflow[]
  workflowVersions           TenantWorkflowVersion[]
  workflowRuns               TenantWorkflowRun[]
  automationRules            TenantAutomationRule[]
  automationRuns             TenantAutomationRun[]
  notificationTemplates      TenantNotificationTemplate[]
  notificationRules          TenantNotificationRule[]
  notificationLogs           TenantNotificationLog[]
  emailProviders             TenantEmailProvider[]
  operatingHours             TenantOperatingHours[]
  serviceDeskQueues          TenantServiceDeskQueue[]
  routingRules               TenantRoutingRule[]
  tenantIntegrations         TenantIntegration[]
  tenantIntegrationLogs      TenantIntegrationLog[]
  tenantApiKeys              TenantApiKey[]
  tenantApiKeyUsage          TenantApiKeyUsage[]
  tenantWebhooks             TenantWebhook[]
  tenantWebhookDeliveries    TenantWebhookDelivery[]
  attachments                TenantAttachment[]
  incidentCategories         TenantIncidentCategory[]
  incidentPriorities         TenantIncidentPriority[]
  resolutionCodes            TenantResolutionCode[]
  problemCategories          TenantProblemCategory[]
  rootCauseCategories        TenantRootCauseCategory[]
  changeTypes                TenantChangeType[]
  changeTemplates            TenantChangeTemplate[]
  changeWindows              TenantChangeWindow[]
  assetModels                TenantAssetModel[]
  assetLicenses              TenantAssetLicense[]
  customFields               TenantCustomField[]
  delegations                TenantDelegation[]
  accessReviews              TenantAccessReview[]
  accessReviewItems          TenantAccessReviewItem[]
  accessPolicies             TenantAccessPolicy[]
  accessPolicyAssignments    TenantAccessPolicyAssignment[]
  importJobs                 TenantImportJob[]

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

model TenantDomain {
  id                String            @id @default(cuid())
  tenantId          String
  domain            String            @unique
  type              DomainType        @default(CUSTOM)
  status            DomainStatus      @default(PENDING_VERIFICATION)
  verificationToken String?
  verifiedAt        DateTime?
  activatedAt       DateTime?
  disabledAt        DateTime?
  certificateStatus CertificateStatus @default(NONE)
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("tenant_domains")
}

model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model TenantMembership {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  roleKey     String    @default("member")
  status      String    @default("ACTIVE")
  invitedById String?
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments TenantUserRole[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId, status])
  @@map("tenant_memberships")
}

// ---------------------------------------------------------------------------
// Tenant (Organization Admin) role-based access control
// ---------------------------------------------------------------------------

model TenantRole {
  id          String           @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  status      TenantRoleStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     TenantRolePermission[]
  userAssignments TenantUserRole[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("tenant_roles")
}

model TenantRolePermission {
  id           String   @id @default(cuid())
  tenantRoleId String
  permissionId String
  createdAt    DateTime @default(now())

  role       TenantRole @relation(fields: [tenantRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantRoleId, permissionId])
  @@map("tenant_role_permissions")
}

model TenantUserRole {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String
  tenantRoleId String
  assignedById String?
  assignedAt   DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       TenantRole       @relation(fields: [tenantRoleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, tenantRoleId])
  @@index([tenantId])
  @@index([tenantRoleId])
  @@map("tenant_user_roles")
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  roleKey     String?
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([status, expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Organization structure: departments, locations, cost centers and teams
// ---------------------------------------------------------------------------

model Department {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  parentId    String?
  managerId   String?
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentHierarchy")
  manager   User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams     Team[]
  incidents Incident[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, parentId])
  @@map("departments")
}

model Location {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  code         String?
  type         String    @default("OFFICE")
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  timezone     String    @default("UTC")
  phone        String?
  status       String    @default("ACTIVE")
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  incidents Incident[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("locations")
}

model CostCenter {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("cost_centers")
}

model Team {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  code         String?
  description  String?
  departmentId String?
  leadId       String?
  email        String?
  status       String    @default("ACTIVE")
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lead            User?            @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  incidents       Incident[]
  problems        Problem[]
  changes         Change[]
  serviceRequests ServiceRequest[]
  catalogItems    CatalogItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  tenantId  String
  teamId    String
  userId    String
  role      String   @default("MEMBER")
  isLead    Boolean  @default(false)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("team_members")
}

model TenantProvisioning {
  id          String             @id @default(cuid())
  tenantId    String
  status      ProvisioningStatus @default(NOT_STARTED)
  steps       Json?
  currentStep String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("tenant_provisionings")
}

model ImpersonationSession {
  id            String    @id @default(cuid())
  tenantId      String
  requestedById String
  targetUserId  String?
  reason        String
  status        String    @default("REQUESTED")
  startsAt      DateTime?
  expiresAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime  @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("ImpersonationRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("impersonation_sessions")
}

// ===========================================================================
// Approvals
// ===========================================================================

model ApprovalPolicy {
  id              String   @id @default(cuid())
  name            String
  description     String?
  actionScope     String
  conditions      Json?
  approverRoleIds Json
  minApprovals    Int      @default(1)
  isEnabled       Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests ApprovalRequest[]

