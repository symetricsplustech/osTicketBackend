  versions        CatalogItemVersion[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("catalog_items")
}

model CatalogItemVersion {
  id            String    @id @default(cuid())
  tenantId      String
  itemId        String
  version       Int
  snapshot      Json
  status        String    @default("PUBLISHED")
  publishedAt   DateTime  @default(now())
  publishedById String?
  retiredAt     DateTime?
  createdAt     DateTime  @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item        CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  publishedBy User?       @relation("CatalogItemVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([itemId, version])
  @@index([tenantId])
  @@map("catalog_item_versions")
}

// ===========================================================================
// ITSM operational records — knowledge, CMDB, assets, discovery, on-call
// (tenant-scoped). Cross-entity references are stored as plain ids; only the
// tenant relation is enforced, to keep the operational surface decoupled from
// platform config tables.
// ===========================================================================

model KnowledgeArticleCategory {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  sortOrder   Int       @default(0)
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   KnowledgeArticleCategory?  @relation("KnowledgeArticleCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children KnowledgeArticleCategory[] @relation("KnowledgeArticleCategoryParent")
  articles KnowledgeArticle[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("knowledge_article_categories")
}

model KnowledgeArticle {
  id              String    @id @default(cuid())
  tenantId        String
  number          String?
  title           String
  summary         String?
  body            String?
  categoryId      String?
  status          String    @default("DRAFT")
  visibility      String    @default("INTERNAL")
  tags            String[]  @default([])
  authorId        String?
  reviewerId      String?
  publishedAt     DateTime?
  reviewedAt      DateTime?
  archivedAt      DateTime?
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  metadata        Json?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category KnowledgeArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments KnowledgeArticleComment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("knowledge_articles")
}

model KnowledgeArticleComment {
  id         String   @id @default(cuid())
  tenantId   String
  articleId  String
  body       String
  isInternal Boolean  @default(false)
  authorId   String?
  createdAt  DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("knowledge_article_comments")
}

model ConfigurationItem {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  ciTypeKey     String    @default("server")
  status        String    @default("ACTIVE")
  criticality   String    @default("MEDIUM")
  environment   String    @default("PRODUCTION")
  ownerId       String?
  supportTeamId String?
  serialNumber  String?
  assetTag      String?
  ipAddress     String?
  hostname      String?
  locationId    String?
  attributes    Json?
  tags          String[]  @default([])
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outgoing CiRelationship[] @relation("CiRelationshipSource")
  incoming CiRelationship[] @relation("CiRelationshipTarget")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, ciTypeKey])
  @@map("configuration_items")
}

model CiRelationship {
  id          String    @id @default(cuid())
  tenantId    String
  sourceCiId  String
  targetCiId  String
  typeKey     String    @default("depends_on")
  description String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source ConfigurationItem @relation("CiRelationshipSource", fields: [sourceCiId], references: [id], onDelete: Cascade)
  target ConfigurationItem @relation("CiRelationshipTarget", fields: [targetCiId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceCiId, targetCiId, typeKey])
  @@index([tenantId])
  @@map("ci_relationships")
}

model Asset {
  id             String    @id @default(cuid())
  tenantId       String
  assetTag       String
  name           String
  categoryKey    String    @default("hardware")
  status         String    @default("IN_STOCK")
  condition      String    @default("GOOD")
  serialNumber   String?
  model          String?
  manufacturer   String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  cost           Decimal?  @db.Decimal(12, 2)
  currency       String    @default("USD")
  assignedToId   String?
  locationId     String?
  ciId           String?
  vendorId       String?
  notes          String?
  attributes     Json?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenance AssetMaintenance[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([tenantId, categoryKey])
  @@map("assets")
}

model AssetMaintenance {
  id            String    @id @default(cuid())
  tenantId      String
  assetId       String
  kind          String    @default("MAINTENANCE")
  status        String    @default("SCHEDULED")
  summary       String
  description   String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  cost          Decimal?  @db.Decimal(12, 2)
  performedById String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([tenantId, status])
  @@map("asset_maintenance")
}

model DiscoveryRun {
  id          String    @id @default(cuid())
  tenantId    String
  profileKey  String?
  name        String?
  status      String    @default("QUEUED")
  mode        String    @default("AGENTLESS")
  startedAt   DateTime?
  completedAt DateTime?
  discovered  Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  failed      Int       @default(0)
  summary     Json?
  error       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results DiscoveryResult[]

  @@index([tenantId, status])
  @@map("discovery_runs")
}

model DiscoveryResult {
  id          String    @id @default(cuid())
  tenantId    String
  runId       String
  ciTypeKey   String?
  name        String
  hostname    String?
  ipAddress   String?
  status      String    @default("PENDING")
  action      String    @default("REVIEW")
