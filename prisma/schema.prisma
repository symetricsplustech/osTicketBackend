  @@map("announcements")
}

// ===========================================================================
// Tenant ITSM: approvals / SLA / workflows / automation / notifications
// ===========================================================================

model TenantApprovalPolicy {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  actionScope     String
  conditions      Json?
  approverRoleIds Json      @default("[]")
  minApprovals    Int       @default(1)
  isEnabled       Boolean   @default(true)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests TenantApprovalRequest[]

  @@unique([tenantId, name])
  @@index([tenantId, actionScope, isEnabled])
  @@map("tenant_approval_policies")
}

model TenantApprovalRequest {
  id            String    @id @default(cuid())
  tenantId      String
  policyId      String?
  actionKey     String
  resourceType  String
  resourceId    String?
  payload       Json?
  reason        String?
  requestedById String?
  status        String    @default("PENDING")
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy    TenantApprovalPolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  decisions TenantApprovalDecision[]

  @@index([tenantId, status])
  @@index([tenantId, actionKey])
  @@map("tenant_approval_requests")
}

model TenantApprovalDecision {
  id         String   @id @default(cuid())
  tenantId   String
  requestId  String
  approverId String?
  decision   String
  reason     String?
  decidedAt  DateTime @default(now())

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request TenantApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@index([tenantId, decision])
  @@map("tenant_approval_decisions")
}

model TenantSlaPolicy {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  status        String    @default("DRAFT")
  serviceLevels Json      @default("[]")
  settings      Json?
  isDefault     Boolean   @default(false)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  escalationRules TenantSlaEscalationRule[]
  ticketSlaInstances TicketSlaInstance[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("tenant_sla_policies")
}

model TenantSlaEscalationRule {
  id               String   @id @default(cuid())
  tenantId         String
  slaPolicyId      String?
  name             String
  trigger          String
  thresholdMinutes Int
  actions          Json     @default("[]")
  isEnabled        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slaPolicy TenantSlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)

  @@index([tenantId, slaPolicyId])
  @@map("tenant_sla_escalation_rules")
}

model TenantBusinessCalendar {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  timezone     String    @default("UTC")
  workingHours Json      @default("{}")
  holidays     Json?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

