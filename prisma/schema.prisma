  updatedAt      DateTime              @updatedAt

  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  queue       SupportQueue?       @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignee    User?               @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  replies     SupportReply[]
  assignments SupportAssignment[]

  @@index([status])
  @@index([tenantId])
  @@map("support_tickets")
}

model SupportReply {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_replies")
}

model SupportAssignment {
  id           String   @id @default(cuid())
  ticketId     String
  assignedToId String
  assignedById String
  note         String?
  createdAt    DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTo User          @relation("SupportAssignmentTarget", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy User          @relation("SupportAssignmentActor", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_assignments")
}

// ===========================================================================
// Auditing
// ===========================================================================

model AuditEvent {
  id           String       @id @default(cuid())
  actorId      String?
  actorEmail   String?
  actorType    String       @default("PLATFORM_STAFF")
  action       String
  resourceType String
  resourceId   String?
  tenantId     String?
  outcome      AuditOutcome @default(SUCCESS)
  before       Json?
  after        Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime     @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resourceType, resourceId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_events")
}

model SecurityEvent {
  id        String           @id @default(cuid())
  eventType String
  severity  SecuritySeverity @default(INFO)
  userId    String?
  tenantId  String?
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime         @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("security_events")
}

model LoginEvent {
  id            String       @id @default(cuid())
  userId        String?
  email         String
  outcome       LoginOutcome
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([outcome])
  @@index([createdAt])
  @@map("login_events")
}

// ===========================================================================
// Platform settings
// ===========================================================================

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  group       String   @default("general")
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("platform_settings")
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  rules             Json?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("feature_flags")
}

model RetentionPolicy {
  id            String          @id @default(cuid())
  resourceKey   String          @unique
  retentionDays Int
  action        RetentionAction @default(ARCHIVE)
  isEnabled     Boolean         @default(true)
  updatedById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("retention_policies")
}

// ===========================================================================
// Reports & background jobs
// ===========================================================================

model ReportJob {
  id            String        @id @default(cuid())
  kind          ReportJobKind @default(REPORT)
  reportKey     String
  format        String        @default("JSON")
  filters       Json?
  status        JobStatus     @default(QUEUED)
  requestedById String?
  tenantScope   String?
  rowCount      Int?
  filePath      String?
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  requestedBy User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  tenant      Tenant? @relation(fields: [tenantScope], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reportKey])
  @@map("report_jobs")
}

model BackgroundJob {
  id           String    @id @default(cuid())
  type         String
  status       JobStatus @default(QUEUED)
  payload      Json?
  result       Json?
  error        String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledFor DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([type])
  @@map("background_jobs")
}

// ===========================================================================
// SLA engine — per-ticket SLA instances and clock events
// ===========================================================================

enum SlaClockEventType {
  START
  PAUSE
  RESUME
  COMPLETE
  BREACH
  RECALCULATE
}

enum SlaInstanceStatus {
  RUNNING
  PAUSED
  MET
  BREACHED
  EXEMPT
}

model TicketSlaInstance {
  id             String              @id @default(cuid())
  tenantId       String
  incidentId     String?
  slaPolicyId    String?
  milestone      String              // "response" | "resolution" | "fulfillment" | "restoration"
  priorityKey    String
  targetMinutes  Int
  startedAt      DateTime?
  deadlineAt     DateTime?
  completedAt    DateTime?
  pausedAt       DateTime?
  pausedDuration Int               @default(0) // minutes excluded under permitted pauses
  status         SlaInstanceStatus   @default(RUNNING)
  breached       Boolean             @default(false)
  breachedAt     DateTime?
  policyKey      String?
  metadata       Json?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident  Incident?               @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  slaPolicy TenantSlaPolicy?        @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  events    SlaClockEvent[]

  @@index([tenantId, incidentId, milestone])
  @@index([tenantId, status])
  @@index([tenantId, deadlineAt])
  @@index([deadlineAt])
  @@map("ticket_sla_instances")
}

model SlaClockEvent {
  id             String           @id @default(cuid())
  tenantId       String
  slaInstanceId  String
  type           SlaClockEventType
  occurredAt     DateTime         @default(now())
  actorId        String?
  reason         String?
  pausedMinutes  Int?
  metadata       Json?
  createdAt      DateTime         @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance TicketSlaInstance @relation(fields: [slaInstanceId], references: [id], onDelete: Cascade)
  actor   User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, slaInstanceId])
  @@index([tenantId, type, occurredAt])
  @@map("sla_clock_events")
}
